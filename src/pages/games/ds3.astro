---
// @ts-nocheck
import BackButton from "../../components/backButton.astro";
import GameCardsGames from "../../components/gameCardsGames.astro";
import { pokemonGames } from "../../java/pokemonGames";

const games = pokemonGames.ds3;
---

<section>
    <div class="back">
        <BackButton href="/games" />

        <div class="navigation">
            <a href="/">Pokedex</a>
            <a href="/games">Games</a>
            <a href="/teams">Teams</a>
            <button class="theme-toggle">Light / Dark</button>
        </div>
    </div>

    <div class="search-bar">
        <div class="search-box">
            <input class="search-input" type="text" placeholder="search..." />

            <span class="magnifying-glass">
                <!--SVG heeft geen vaste grootte gekregen. De class="size-6" die het heeft gekregen komt uit Tailwind CSS. Omdat ik gewone CSS gebruik doet het niks.
                    Vandaar dat ik het een andere class geef.-->
                <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
                </svg>
            </span>
        </div>
    </div>
</section>

    <!--Canvas API -->
    <canvas id="confetti"></canvas>

<div class="games">
    { games.map((game) => (
        <GameCardsGames game={game} />
        ))
    }
</div>

<script src="../../java/thema.js"></script>
<script src="../../java/search.js"></script>
<script src="../../java/navigatie.js"></script>

<style>
    body.dark-mode {
        background: black;
    }

    body.dark-mode h1 {
        color: white;
    }

    .back {
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
        max-width: 1200px;
        margin: 2rem auto;
    }

    .back :global(.back-button) {
        position: absolute;
        left: 0;
    }

    /*Knoppen in navigatiebar*/
    .navigation {
        display: flex;
        width: 70%;
        gap: 1rem;
        margin-left: 4rem;
    }

    .navigation a, .navigation button {
        flex: 1;
        background: #d9d9d9;
        border: none;
        border-radius: 20px;

        padding: 1rem 2rem;
        font-size: 1rem;
        font-weight: bold;
        cursor: pointer;

        color: black;
        text-decoration: none;
    }

    /*Zoekbalk met plaatje*/
    .search-bar {
        display: flex;
        justify-content: center;
        margin: 2rem 0;
    }

    .search-box {
        position: relative;
        width: 70%;
        max-width: 900px;
    }

    .search-box input {
        background: #e9e9e9;
        width: 100%;
        max-width: 900px;
        padding: 1rem 3.5rem 1rem 1.5rem;

        border: none;
        border-radius: 25px;
        box-sizing: border-box;
        font-size: 1rem;
        outline: none;
    }

    .magnifying-glass {
        position: absolute;
        right: 1rem;
        top: 50%;
        font-size: 1.5rem;
        
        transform: translateY(-50%);
    }

    .search-icon {
        width: 24px;
        height: 24px;
    }

    .games {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2rem;

        width: 90%;
        max-width: 1000px;
        margin: 2rem auto;
    }

    /*Confetti*/
    #confetti {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 9999;
    }

    /*Responsive*/
    @media (max-width: 900px) {
        .games {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 600px) {
        .back {
            flex-direction: column;
            width: 90%;
        }

        .back :global(.back-button) {
            position: static;
            margin-bottom: 1rem;
            align-self: flex-start;
        }

        .navigation {
            width: 100%;
            margin-left: 0;
            flex-direction: column;
        }

        .search-box {
            width: 100%;
        }

        .games {
            grid-template-columns: 1fr;
        }
    }
</style>