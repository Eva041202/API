---
// @ts-nocheck
import { pokemonGames } from "../../java/pokemonGames";

const games = pokemonGames.gameboy;
---

<h1>Gameboy Games</h1>

<div class="game-grid">
    { games.map((game) => (
        <div class="card">
            <img src={game.image} alt={game.name} />

            <p>{game.releaseDate}</p>

            <h2>{game.name}</h2>
        </div>
    ))
}
</div>