---
// @ts-nocheck
import BackButton from "../../components/backButton.astro";
import GameCardsGames from "../../components/gameCardsGames.astro";
import { pokemonGames } from "../../java/pokemonGames";

const games = pokemonGames.wii;
---

<BackButton href="/games" />

<section>
    <h1>Wii Games</h1>

    <div class="navigation">
        <a href="/">Pokedex</a>
        <a href="/games">Games</a>
        <a href="/teams">Teams</a>
        <button>Light / Dark</button>
    </div>

    <div class="search-bar">
        <div class="search-box">
            <input type="text" placeholder="search..." />

            <span class="magnifying-glass">
                <!--SVG heeft geen vaste grootte gekregen. De class="size-6" die het heeft gekregen komt uit Tailwind CSS. Omdat ik gewone CSS gebruik doet het niks.
                    Vandaar dat ik het een andere class geef.-->
                <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
                </svg>
            </span>
        </div>
    </div>
</section>

<div class="games">
    { games.map((game) => (
        <GameCardsGames game={game} />
        ))
    }
</div>

<style>
    /*Knoppen in navigatiebar*/
    .navigation {
        display: flex;
        justify-content: space-between;
        width: 70%;
        max-width: 900px;

        gap: 1rem;
        margin: 2rem auto;
    }

    .navigation a, .navigation button {
        flex: 1;
        background: #d9d9d9;
        border: none;
        border-radius: 20px;

        padding: 1rem 2rem;
        font-size: 1rem;
        font-weight: bold;
        cursor: pointer;
    }

    /*Zoekbalk met plaatje*/
    .search-bar {
        display: flex;
        justify-content: center;
        margin: 2rem 0;
    }

    .search-box {
        position: relative;
        width: 70%;
        max-width: 900px;
    }

    .search-box input {
        background: #e9e9e9;
        width: 100%;
        max-width: 900px;
        padding: 1rem 3.5rem 1rem 1.5rem;

        border: none;
        border-radius: 25px;
        box-sizing: border-box;
        font-size: 1rem;
        outline: none;
    }

    .magnifying-glass {
        position: absolute;
        right: 1rem;
        top: 50%;
        font-size: 1.5rem;
        
        transform: translateY(-50%);
    }

    .search-icon {
        width: 24px;
        height: 24px;
    }

    .games {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2rem;
        max-width: 1000px;
        margin: 2rem auto;
    }
</style>