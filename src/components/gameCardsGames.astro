---
const { game } = Astro.props;
---

<a href={`/games/gameboy/${game.slug}`} class="game-card">
    <img src={game.image.src} alt={game.name} />

    <div class="info-game">
        <h2>{game.name}</h2>
        <p>{game.releaseDate}</p>
    </div>
</a>

<style>
    .game-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;

        color: black;
        text-decoration: none;
    }

    body.dark-mode .game-card {
        color: white;
    }

    .game-card img {
        width: 100%;
        max-width: 200px;
        max-height: 200px;
        object-fit: contain;
        border-radius: 20px;
    }

    .info-game {
        display: flex;
        flex-direction: column;
    }

    .info-game h2 {
        margin: 0;
        font-size: 1.5rem;
    }

    .info-game p {
        margin-top: .5rem;
    }
</style>