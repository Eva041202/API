---
const { href = "/" } = Astro.props;
---

<a href={href} class="back-button">
    Back
</a>

<style>
    .back-button {
        display: inline-block;
        margin: 2rem;
        padding: 0.75rem 1.5rem;

        background: #d83a3a;
        color: yellow;
        text-decoration: none;
        border-radius: 1000px;
        font-weight: bold;
    }
</style>