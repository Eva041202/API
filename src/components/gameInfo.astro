---
// Bronnen: Vragen + uitleg: chatgpt
// @ts-nocheck
const { game } = Astro.props;

let pokemon = [];

if (game.generation) {
    for (const gen of game.generation) {
        const response = await fetch(
        `https://pokeapi.co/api/v2/pokemon?offset=${gen.offset}&limit=${gen.count}`
        );

        const data = await response.json();

        pokemon.push(
            ...data.results.map((p) => ({
                id: p.url.split("/")[6],
                name: p.name,
                image: `https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/${p.url.split("/")[6]}.png`
            }))
        );
    }
}

//Eventuele extra pokemon
if (game.pokemon) {
    pokemon.push(
        ...game.pokemon.map((p) => ({
            id: p.id,
            name: p.name,
            image: `https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/${p.id}.png`
        }))
    );
}
---

<div class="game-info-container">
    <div class="left">
        <img src={game.image.src} alt={game.name} />
    </div>

    <div class="game-info">
        <h1>{game.name}</h1>

        {game.description.map(paragraph => (
            <p>{paragraph}</p>
        ))}
    </div>

    <div class="locations">
        <h2>Te vinden locaties:</h2>

        <ul>
            {game.locations.map(location => (
                <li>{location}</li>
                ))
            }
        </ul>
    </div>

    <div class="game-pokemon">
        <h2>Te vinden Pokemon:</h2>

        <div class="game-pokemon-scroll">
            {pokemon.map((pokemon) => (
                <div class="game-pokemon-card">
                    <img src={pokemon.image} alt={pokemon.name} />

                    <p>{pokemon.name}</p>
                </div>
            ))}
        </div>
    </div>
</div>

<style>
    * {
        font-family: sans-serif;
    }

    .game-info-container {
        display: grid;
        grid-template-columns: 300px 1fr;
        grid-template-rows: auto auto;
        gap: 2rem;
        max-width: 1000px;
        margin: 3rem auto;
    }

    .left {
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .left img {
        width: 250px;
        border-radius: 20px;
    }

    .game-info {
        padding: 1rem;
        max-width: 700px;
    }

    .locations {
        padding: 1rem;
        background: rgba(0,0,0,0.05);
        border-radius: 20px;
    }

    .game-pokemon {
        padding: 1rem;
        max-width: 700px;
        background: rgba(0,0,0,0.05);
        border-radius: 20px;
    }

    .game-pokemon-scroll {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
        max-height: 200px;
        gap: 1rem;
        overflow-y: auto;
    }

    .game-pokemon-card {
        min-width: 100px;
        text-align: center;
    }

    .game-pokemon-card img {
        width: 80px;
    }

    /*Responsive*/
    @media (max-width: 900px) {
        .game-info {
            grid-template-columns: 1fr;
        }

        .bottom {
            grid-template-columns: 1fr;
        }

        .left {
            text-align: center;
        }

        .left img {
            max-width: 250px;
            width: 100%;
        }
    }

    @media (max-width: 700px) {
        .bottom {
            grid-template-columns: 1fr;
        }
    }
</style>