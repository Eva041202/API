---
// Bronnen: Vragen + uitleg: chatgpt
const { game } = Astro.props;
---

<a href={`/games/${game.slug}`} class="game-link">
    <div class="game-card">
        <img src={game.image.src} alt={game.name} />

        <h2>{game.name}</h2>
    </div>
</a>

<style>
    * {
        font-family: sans-serif;
    }

    .game-link {
        color: black;
        text-decoration: none;
    }

    .game-card {
        display: flex;
        flex-direction: column;
        align-items: center;

        background: #e8e8e8;
        border: 10px solid red;
        border-radius: 20px;
        padding: 1rem;
    }

    .game-card img {
        width: 100%;
        max-width: 200px;
        aspect-ratio: 1 / 1;
        object-fit: cover;
        align-items: center;
    }

    .game-card h2 {
        margin-top: 1rem;
        text-align: center;
    }
</style>