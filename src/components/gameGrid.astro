---
// @ts-nocheck
import GameCards from "./gameCards.astro";

const { games } = Astro.props;
---

<div class="game-grid">
    {
        games.map((game) => (
            <GameCards game={game} />
        ))
    }
</div>

<style>
    .game-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));

        gap: 2rem;
        width: 90%;
        max-width: 1200px;
        margin: 2rem auto;
    }
</style>