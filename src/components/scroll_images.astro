---
import gameboyGames from "../assets/media/gameboyGames.jpg";
import pokemonCards from "../assets/media/pokemonCards.jpg";
import gameboy from "../assets/media/gameboy.jpg";
import charizard from "../assets/media/charizard.jpg";
import pikachu from "../assets/media/pikachu.jpg";
import bulbasaur from "../assets/media/bulbasaur.jpg";
---


<div class="scroll-container">
    <div class="grid">
        <div class="image">
            <img src={gameboyGames.src} alt="gameboy games">
        </div>
    
        <div class="image">
            <img src={pokemonCards.src} alt="pokemon cards">
        </div>
    
        <div class="image">
            <img src={gameboy.src} alt="gameboy">
        </div>
    
        <div class="image">
            
        </div>
    
        <div class="image">
            <img src={charizard.src} alt="shiny charizard">
        </div>
    
        <div class="image">
            <img src={pikachu.src} alt="pikachu">
        </div>
    
        <div class="image">
            <img src={bulbasaur.src} alt="bulbasaur">
        </div>
    </div>
</div>


<style>
    body {
    margin: 0;
    }

    .scroll-container {
    height: 400svh;
    overflow: clip;
    }

    .grid {
    position: sticky;
    top: 0;

    padding: 0,5rem; /* Net zo groot als m'n gap */
    display: grid;
    gap: 0.5rem;
    grid-template-columns: 1fr 1fr 1fr 1fr;
    grid-template-rows: 1fr 1fr 1fr;

    height: calc(100svh - 1rem);
    padding: 0.5rem;
    animation-name: enlarge-image;
    animation-timeline: view();
    animation-range: entry 100svh contain;
    animation-fill-mode: both;

    .image {
        position: relative;
        width: 100%;
        height: 100%;
        border-radius: 0.5rem;
        overflow: clip;
        &:nth-of-type(5n + 1),
        &:nth-of-type(5n + 2),
        &:nth-of-type(5n + 4) {
        grid-column: span 2;
        }
    
    img {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height:100%;
        object-fit: cover;
        }
    }
    }

    @keyframes enlarge-image {
    to {
        scale: 3.15;
        }
    }

    section {
    
    }
</style>